@@ -0,0 +1,42 @@
+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package reflect
+
+import (
+	"context"
+
+	"github.com/hashicorp/terraform-plugin-go/tftypes"
+
+	"github.com/hashicorp/terraform-plugin-framework/attr"
+	"github.com/hashicorp/terraform-plugin-framework/attr/xattr"
+	"github.com/hashicorp/terraform-plugin-framework/diag"
+	"github.com/hashicorp/terraform-plugin-framework/path"
+)
+
+// validateAttributeValue returns the diagnostics of validating val, which was
+// produced by typ from tfVal: val's ValidateAttribute method if val implements
+// xattr.ValidateableAttribute, otherwise the deprecated Validate method of typ
+// if typ implements xattr.TypeWithValidate, otherwise nil.
+func validateAttributeValue(ctx context.Context, typ attr.Type, val attr.Value, tfVal tftypes.Value, path path.Path) diag.Diagnostics {
+	switch t := val.(type) {
+	case xattr.ValidateableAttribute:
+		resp := xattr.ValidateAttributeResponse{}
+
+		t.ValidateAttribute(ctx,
+			xattr.ValidateAttributeRequest{
+				Path: path,
+			},
+			&resp,
+		)
+
+		return resp.Diagnostics
+	default:
+		//nolint:staticcheck // xattr.TypeWithValidate is deprecated, but we still need to support it.
+		if typeWithValidate, ok := typ.(xattr.TypeWithValidate); ok {
+			return typeWithValidate.Validate(ctx, tfVal, path)
+		}
+	}
+
+	return nil
+}

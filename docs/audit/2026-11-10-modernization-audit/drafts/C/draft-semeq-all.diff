+
+// valueSemanticEqualityNested performs type-based semantic equality for a
+// value type with nested values (elements or attributes). V is the
+// basetypes.<Type>ValuableWithSemanticEquals interface, semanticEquals calls
+// its <Type>SemanticEquals method and nested performs semantic equality on the
+// nested values.
+//
+// Nested values are checked whenever the type does not implement the
+// interface or does not signal semantic equality, since it cannot be assumed
+// that the type implementation runs all possible nested value
+// implementations. While correct implementations receive a small performance
+// penalty of being re-checked, this ensures that less-correct implementations
+// do not cause inconsistent data handling behaviors for developers.
+func valueSemanticEqualityNested[V attr.Value](ctx context.Context, req ValueSemanticEqualityRequest, resp *ValueSemanticEqualityResponse, semanticEquals func(ctx context.Context, proposedNewValuable, priorValuable V) (bool, diag.Diagnostics), nested func(context.Context, ValueSemanticEqualityRequest, *ValueSemanticEqualityResponse)) {
+	priorValuable, ok := req.PriorValue.(V)
+
+	if !ok {
+		nested(ctx, req, resp)
+
+		return
+	}
+
+	proposedNewValuable, ok := req.ProposedNewValue.(V)
+
+	if !ok {
+		nested(ctx, req, resp)
+
+		return
+	}
+
+	logging.FrameworkTrace(
+		ctx,
+		"Calling provider defined type-based SemanticEquals",
+		map[string]interface{}{
+			logging.KeyValueType: proposedNewValuable.String(),
+		},
+	)
+
+	usePriorValue, diags := semanticEquals(ctx, proposedNewValuable, priorValuable)
+
+	logging.FrameworkTrace(
+		ctx,
+		"Called provider defined type-based SemanticEquals",
+		map[string]interface{}{
+			logging.KeyValueType: proposedNewValuable.String(),
+		},
+	)
+
+	resp.Diagnostics.Append(diags...)
+
+	if resp.Diagnostics.HasError() {
+		return
+	}
+
+	// If the type signaled semantic equality, respect the determination to
+	// use the whole prior value and return early since checking nested values
+	// is not necessary.

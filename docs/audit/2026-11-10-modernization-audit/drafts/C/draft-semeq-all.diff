+func valueSemanticEqualityScalar[V attr.Value](ctx context.Context, req ValueSemanticEqualityRequest, resp *ValueSemanticEqualityResponse, semanticEquals func(ctx context.Context, proposedNewValuable, priorValuable V) (bool, diag.Diagnostics)) {
+	priorValuable, ok := req.PriorValue.(V)
+
+	// No changes required if the interface is not implemented.
+	if !ok {
+		return
+	}
+
+	proposedNewValuable, ok := req.ProposedNewValue.(V)
+
+	// No changes required if the interface is not implemented.

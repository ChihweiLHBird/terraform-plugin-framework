 }
+
+// applyDefault appends the diagnostics of a schema default value response and,
+// unless they contain an error or the response declared a collection default
+// without an element type (noElementType), returns the Terraform value of the
+// default. Otherwise the current value is kept.
+func applyDefault(ctx context.Context, diags *diag.Diagnostics, fwPath path.Path, tfTypeValue tftypes.Value, respDiags diag.Diagnostics, planValue attr.Value, noElementType bool) (tftypes.Value, error) {
+	diags.Append(respDiags...)
+
+	if respDiags.HasError() {
+		return tfTypeValue, nil
+	}
+
+	if noElementType {
+		logging.FrameworkWarn(ctx, "attribute default declared, but returned no value")
+
+		return tfTypeValue, nil
+	}
+
+	logging.FrameworkTrace(ctx, fmt.Sprintf("setting attribute %s to default value: %s", fwPath, planValue))
+
+	return planValue.ToTerraformValue(ctx)
+}

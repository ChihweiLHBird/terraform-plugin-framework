+// valuePlanModifyRequest has the fields of every planmodifier.<Type>Request,
+// in the same order, so each of those types converts to and from it.
+type valuePlanModifyRequest[Value attr.Value] struct {
+	Path           path.Path
+	PathExpression path.Expression
+	Config         tfsdk.Config
+	ConfigValue    Value
+	Plan           tfsdk.Plan
+	PlanValue      Value
+	State          tfsdk.State
+	StateValue     Value
+	Private        *privatestate.ProviderData
+}
+
+// valuePlanModifyResponse has the fields of every
+// planmodifier.<Type>Response, in the same order, so a pointer to it converts
+// to a pointer to each of those types.
+type valuePlanModifyResponse[Value attr.Value] struct {
+	PlanValue       Value
+	RequiresReplace bool
+	Private         *privatestate.ProviderData
+	Diagnostics     diag.Diagnostics
+}
+
+// valuePlanModifyType holds the type-specific parts of plan modification for
+// one value type, such as Bool: the basetypes.BoolValuable, basetypes.BoolValue
+// and basetypes.BoolTypable types, and the planmodifier.Bool interface.
+type valuePlanModifyType[Valuable attr.Value, Value attr.Value, Typable any, Modifier planmodifier.Describer] struct {
+	name      string
+	toValue   func(Valuable, context.Context) (Value, diag.Diagnostics)
+	typable   func(context.Context, path.Path, Valuable) (Typable, diag.Diagnostics)
+	valueFrom func(Typable, context.Context, Value) (Valuable, diag.Diagnostics)
+	modify    func(Modifier, context.Context, valuePlanModifyRequest[Value], *valuePlanModifyResponse[Value])
+}
+
+// valuePlanModify performs all plan modification of one value type for an
+// attribute or block, where kind is "Attribute" or "Block".
+func valuePlanModify[Valuable attr.Value, Value attr.Value, Typable any, Modifier planmodifier.Describer](ctx context.Context, t valuePlanModifyType[Valuable, Value, Typable, Modifier], kind string, planModifiers func() []Modifier, req ModifyAttributePlanRequest, resp *ModifyAttributePlanResponse) {
+	// Use basetypes.<Type>Valuable until custom types cannot re-implement
+	// ValueFromTerraform. Until then, custom types are not technically
+	// required to implement this interface. This opts to enforce the
+	// requirement before compatibility promises would interfere.
+	configValuable, ok := req.AttributeConfig.(Valuable)
+
+	if !ok {
+		addValuePlanModifyTypeError(resp, t.name, kind, req.AttributePath, req.AttributeConfig)
+
+		return
+	}
+
+	configValue, diags := t.toValue(configValuable, ctx)
+
+	resp.Diagnostics.Append(diags...)
+
+	// Only return early on new errors as the resp.Diagnostics may have errors
+	// from other attributes.
+	if diags.HasError() {
+		return
+	}
+
+	planValuable, ok := req.AttributePlan.(Valuable)
+
+	if !ok {
+		addValuePlanModifyTypeError(resp, t.name, kind, req.AttributePath, req.AttributePlan)
+
+		return
+	}
+
+	planValue, diags := t.toValue(planValuable, ctx)
+
+	resp.Diagnostics.Append(diags...)
+
+	// Only return early on new errors as the resp.Diagnostics may have errors
+	// from other attributes.
+	if diags.HasError() {
+		return
+	}
+
+	stateValuable, ok := req.AttributeState.(Valuable)
+
+	if !ok {
+		addValuePlanModifyTypeError(resp, t.name, kind, req.AttributePath, req.AttributeState)
+
+		return
+	}
+
+	stateValue, diags := t.toValue(stateValuable, ctx)
+
+	resp.Diagnostics.Append(diags...)
+
+	// Only return early on new errors as the resp.Diagnostics may have errors
+	// from other attributes.
+	if diags.HasError() {
+		return
+	}
+
+	typable, diags := t.typable(ctx, req.AttributePath, planValuable)
+
+	resp.Diagnostics.Append(diags...)
+
+	// Only return early on new errors as the resp.Diagnostics may have errors
+	// from other attributes.
+	if diags.HasError() {
+		return
+	}
+
+	planModifyReq := valuePlanModifyRequest[Value]{
+		Config:         req.Config,
+		ConfigValue:    configValue,
+		Path:           req.AttributePath,
+		PathExpression: req.AttributePathExpression,
+		Plan:           req.Plan,
+		PlanValue:      planValue,
+		Private:        req.Private,
+		State:          req.State,
+		StateValue:     stateValue,
+	}
+
+	for _, planModifier := range planModifiers() {
+		// Instantiate a new response for each request to prevent plan modifiers
+		// from modifying or removing diagnostics.
+		planModifyResp := &valuePlanModifyResponse[Value]{
+			PlanValue: planModifyReq.PlanValue,
+			Private:   resp.Private,
+		}
+
+		logging.FrameworkTrace(
+			ctx,
+			"Calling provider defined planmodifier."+t.name,
+			map[string]any{
+				logging.KeyDescription: planModifier.Description(ctx),
+			},
+		)
+
+		t.modify(planModifier, ctx, planModifyReq, planModifyResp)
+
+		logging.FrameworkTrace(
+			ctx,
+			"Called provider defined planmodifier."+t.name,
+			map[string]any{
+				logging.KeyDescription: planModifier.Description(ctx),
+			},
+		)
+
+		// Prepare next request with base type.
+		planModifyReq.PlanValue = planModifyResp.PlanValue
+
+		resp.Diagnostics.Append(planModifyResp.Diagnostics...)
+		resp.Private = planModifyResp.Private
+
+		if planModifyResp.RequiresReplace {
+			resp.RequiresReplace.Append(req.AttributePath)
+		}
+
+		// Only on new errors.
+		if planModifyResp.Diagnostics.HasError() {
+			return
+		}
+
+		// A custom value type must be returned in the final response to prevent
+		// later correctness errors.
+		// Reference: https://github.com/hashicorp/terraform-plugin-framework/issues/754
+		valuable, valueFromDiags := t.valueFrom(typable, ctx, planModifyResp.PlanValue)
+
+		resp.Diagnostics.Append(valueFromDiags...)
+
+		// Only on new errors.
+		if valueFromDiags.HasError() {
+			return
+		}
+
+		resp.AttributePlan = valuable
+	}
+}
+
+func addValuePlanModifyTypeError(resp *ModifyAttributePlanResponse, typeName string, kind string, attributePath path.Path, value attr.Value) {
+	resp.Diagnostics.AddAttributeError(
+		attributePath,
+		"Invalid "+typeName+" "+kind+" Plan Modifier Value Type",
+		"An unexpected value type was encountered while attempting to perform "+typeName+" "+strings.ToLower(kind)+" plan modification. "+
+			"The value type must implement the basetypes."+typeName+"Valuable interface. "+
+			"Please report this to the provider developers.\n\n"+
+			fmt.Sprintf("Incoming Value Type: %T", value),
+	)
+}

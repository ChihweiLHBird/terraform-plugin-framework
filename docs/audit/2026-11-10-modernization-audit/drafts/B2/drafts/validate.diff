diff -ruN -x .git -x docs -x '*.orig' -x '*.out' -x '*.test' a/internal/fwserver/server_validateconfig.go b/internal/fwserver/server_validateconfig.go
--- a/internal/fwserver/server_validateconfig.go	1970-01-01 00:00:00.000000000 +0000
+++ b/internal/fwserver/server_validateconfig.go	2026-10-24 23:17:36.273594164 +0000
@@ -0,0 +1,56 @@
+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package fwserver
+
+import (
+	"context"
+
+	"github.com/hashicorp/terraform-plugin-framework/diag"
+	"github.com/hashicorp/terraform-plugin-framework/internal/logging"
+	"github.com/hashicorp/terraform-plugin-framework/schema/validator"
+	"github.com/hashicorp/terraform-plugin-framework/tfsdk"
+)
+
+// runConfigValidators calls validate for each provider-defined config
+// validator, logging name around each call, and appends the diagnostics.
+func runConfigValidators[V interface{ Description(context.Context) string }](ctx context.Context, name string, configValidators []V, diags *diag.Diagnostics, validate func(V) diag.Diagnostics) {
+	for _, configValidator := range configValidators {
+		logging.FrameworkTrace(
+			ctx,
+			"Calling provider defined "+name,
+			map[string]interface{}{
+				logging.KeyDescription: configValidator.Description(ctx),
+			},
+		)
+		validateDiags := validate(configValidator)
+		logging.FrameworkTrace(
+			ctx,
+			"Called provider defined "+name,
+			map[string]interface{}{
+				logging.KeyDescription: configValidator.Description(ctx),
+			},
+		)
+
+		diags.Append(validateDiags...)
+	}
+}
+
+// validateConfigSchema validates config against its schema. The
+// WriteOnlyAttributesAllowed capability is only valid for resource schemas,
+// so it must be false for all other schema types.
+func validateConfigSchema(ctx context.Context, config tfsdk.Config, writeOnlyAttributesAllowed bool) diag.Diagnostics {
+	validateSchemaReq := ValidateSchemaRequest{
+		ClientCapabilities: validator.ValidateSchemaClientCapabilities{
+			WriteOnlyAttributesAllowed: writeOnlyAttributesAllowed,
+		},
+		Config: config,
+	}
+	// Instantiate a new response for each request to prevent validators
+	// from modifying or removing diagnostics.
+	validateSchemaResp := ValidateSchemaResponse{}
+
+	SchemaValidate(ctx, config.Schema, validateSchemaReq, &validateSchemaResp)
+
+	return validateSchemaResp.Diagnostics
+}

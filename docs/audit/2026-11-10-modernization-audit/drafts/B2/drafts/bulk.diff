diff -ruN -x .git -x docs -x '*.orig' -x '*.out' -x '*.test' a/internal/fwserver/server_concepts.go b/internal/fwserver/server_concepts.go
--- a/internal/fwserver/server_concepts.go	1970-01-01 00:00:00.000000000 +0000
+++ b/internal/fwserver/server_concepts.go	2026-10-24 23:15:34.892440623 +0000
@@ -0,0 +1,82 @@
+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package fwserver
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/hashicorp/terraform-plugin-framework/diag"
+	"github.com/hashicorp/terraform-plugin-framework/internal/logging"
+)
+
+// newInstance returns a new instance from the factory function registered for
+// typeName in funcs, otherwise it adds an error diagnostic with the given
+// summary and detail, a format with a single %q verb for the type name.
+func newInstance[T any](funcs map[string]func() T, diags diag.Diagnostics, typeName, summary, detail string) (T, diag.Diagnostics) {
+	factory, ok := funcs[typeName]
+
+	if !ok {
+		diags.AddError(summary, fmt.Sprintf(detail, typeName))
+
+		var zero T
+
+		return zero, diags
+	}
+
+	return factory(), diags
+}
+
+// typeNameMetadatas returns a metadata value for each type name in funcs for
+// the GetMetadata RPC.
+func typeNameMetadatas[M ~struct{ TypeName string }, F any](funcs map[string]F) []M {
+	metadatas := make([]M, 0, len(funcs))
+
+	for typeName := range funcs {
+		metadatas = append(metadatas, M{TypeName: typeName})
+	}
+
+	return metadatas
+}
+
+// validatedSchemas returns the schemas of the instances created from funcs for
+// the GetProviderSchema RPC, without caching. getSchema calls the
+// provider-defined Schema method of an instance and returns the schema, its
+// ValidateImplementation method and the method diagnostics. Schemas with error
+// diagnostics are omitted; all diagnostics are appended to diags.
+func validatedSchemas[T, S any](
+	ctx context.Context,
+	funcs map[string]func() T,
+	diags diag.Diagnostics,
+	logKey, callingLog, calledLog string,
+	getSchema func(T) (S, func(context.Context) diag.Diagnostics, diag.Diagnostics),
+) (map[string]S, diag.Diagnostics) {
+	schemas := make(map[string]S)
+
+	for typeName, factory := range funcs {
+		instance := factory()
+
+		logging.FrameworkTrace(ctx, callingLog, map[string]interface{}{logKey: typeName})
+		schema, validateImplementation, schemaDiags := getSchema(instance)
+		logging.FrameworkTrace(ctx, calledLog, map[string]interface{}{logKey: typeName})
+
+		diags.Append(schemaDiags...)
+
+		if schemaDiags.HasError() {
+			continue
+		}
+
+		validateDiags := validateImplementation(ctx)
+
+		diags.Append(validateDiags...)
+
+		if validateDiags.HasError() {
+			continue
+		}
+
+		schemas[typeName] = schema
+	}
+
+	return schemas, diags
+}

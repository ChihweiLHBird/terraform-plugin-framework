+	logging.FrameworkTrace(ctx, "Calling provider defined Action Configure")
+	actionWithConfigure.Configure(ctx, configureReq, &configureResp)
+	logging.FrameworkTrace(ctx, "Called provider defined Action Configure")
+
+	return configureResp.Diagnostics, true
+}
+
+func (s *Server) configureStateStore(ctx context.Context, ss statestore.StateStore) (diag.Diagnostics, bool) {
+	stateStoreWithConfigure, ok := ss.(statestore.StateStoreWithConfigure)
+	if !ok {
+		return nil, false
+	}
+
+	logging.FrameworkTrace(ctx, "StateStore implements StateStoreWithConfigure")
+
+	configureReq := statestore.ConfigureRequest{
+		StateStoreData: s.StateStoreConfigureData.StateStoreConfigureData,
+	}
+	configureResp := statestore.ConfigureResponse{}
+
+	logging.FrameworkTrace(ctx, "Calling provider defined StateStore Configure")
+	stateStoreWithConfigure.Configure(ctx, configureReq, &configureResp)
+	logging.FrameworkTrace(ctx, "Called provider defined StateStore Configure")
+
+	return configureResp.Diagnostics, true
+}
+
+func (s *Server) configureListResource(ctx context.Context, l list.ListResource) (diag.Diagnostics, bool) {
+	listResourceWithConfigure, ok := l.(list.ListResourceWithConfigure)

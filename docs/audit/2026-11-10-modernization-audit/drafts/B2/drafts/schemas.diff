diff -ruN -x .git -x docs -x '*.orig' -x '*.out' -x '*.test' a/internal/fwserver/schema_cache.go b/internal/fwserver/schema_cache.go
--- a/internal/fwserver/schema_cache.go	1970-01-01 00:00:00.000000000 +0000
+++ b/internal/fwserver/schema_cache.go	2026-10-24 23:14:19.370980825 +0000
@@ -0,0 +1,33 @@
+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package fwserver
+
+import "sync"
+
+// schemaCache is a concurrency-safe cache of schemas (or definitions) by
+// type name, populated on first use by the RPCs that need them.
+type schemaCache[S any] struct {
+	mu      sync.RWMutex
+	schemas map[string]S
+}
+
+func (c *schemaCache[S]) get(typeName string) (S, bool) {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+
+	schema, ok := c.schemas[typeName]
+
+	return schema, ok
+}
+
+func (c *schemaCache[S]) set(typeName string, schema S) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if c.schemas == nil {
+		c.schemas = make(map[string]S)
+	}
+
+	c.schemas[typeName] = schema
+}

package fwserver

import (
	"context"
	"github.com/hashicorp/terraform-plugin-framework/diag"
	"github.com/hashicorp/terraform-plugin-framework/internal/logging"
	"github.com/hashicorp/terraform-plugin-framework/list"
	"github.com/hashicorp/terraform-plugin-framework/x"
	"github.com/hashicorp/terraform-plugin-framework/schema/validator"
	"github.com/hashicorp/terraform-plugin-framework/tfsdk"
)

// ValidateXConfigRequest is the framework server request for the
// ValidateXConfig RPC.
type ValidateXConfigRequest struct {
	Config       *tfsdk.Config
	X pkg.X
}

// ValidateXConfigResponse is the framework server response for the
// ValidateXConfig RPC.
type ValidateXConfigResponse struct {
	Diagnostics diag.Diagnostics
}

// ValidateXConfig implements the framework server ValidateXConfig RPC.
func (s *Server) ValidateXConfig(ctx context.Context, req *ValidateXConfigRequest, resp *ValidateXConfigResponse) {
	if req == nil || req.Config == nil {
		return
	}

	if listResourceWithConfigure, ok := req.X.(list.ListResourceWithConfigure); ok {
		logging.FrameworkTrace(ctx, "X implements ListResourceWithConfigure")

		configureReq := x.ConfigureRequest{
			ProviderData: s.ListResourceConfigureData,
		}
		configureResp := x.ConfigureResponse{}

		logging.FrameworkTrace(ctx, "Calling x defined X Configure")
		listResourceWithConfigure.Configure(ctx, configureReq, &configureResp)
		logging.FrameworkTrace(ctx, "Called x defined X Configure")

		resp.Diagnostics.Append(configureResp.Diagnostics...)

		if resp.Diagnostics.HasError() {
			return
		}
	}

	vdscReq := pkg.ValidateConfigRequest{
		Config: *req.Config,
	}

	if listXWithConfigValidators, ok := req.X.(list.XWithConfigValidators); ok {
		logging.FrameworkTrace(ctx, "X implements XWithConfigValidators")

		for _, configValidator := range listXWithConfigValidators.ListResourceConfigValidators(ctx) {
			vdscResp := &pkg.ValidateConfigResponse{}

			logging.FrameworkTrace(
				ctx,
				"Calling x defined ListResourceConfigValidator",
				map[string]interface{}{
					logging.KeyDescription: configValidator.Description(ctx),
				},
			)
			configValidator.ValidateXConfig(ctx, vdscReq, vdscResp)
			logging.FrameworkTrace(
				ctx,
				"Called x defined ListResourceConfigValidator",
				map[string]interface{}{
					logging.KeyDescription: configValidator.Description(ctx),
				},
			)

			resp.Diagnostics.Append(vdscResp.Diagnostics...)
		}
	}

	if listXWithValidateConfig, ok := req.X.(list.XWithValidateConfig); ok {
		logging.FrameworkTrace(ctx, "X implements XWithValidateConfig")

		vdscResp := &pkg.ValidateConfigResponse{}

		logging.FrameworkTrace(ctx, "Calling x defined X ValidateConfig")
		listXWithValidateConfig.ValidateXConfig(ctx, vdscReq, vdscResp)
		logging.FrameworkTrace(ctx, "Called x defined X ValidateConfig")

		resp.Diagnostics.Append(vdscResp.Diagnostics...)
	}

	schemaCapabilities := validator.ValidateSchemaClientCapabilities{
		WriteOnlyAttributesAllowed: false,
	}

	validateSchemaReq := ValidateSchemaRequest{
		ClientCapabilities: schemaCapabilities,
		Config:             *req.Config,
	}
	validateSchemaResp := ValidateSchemaResponse{}

	SchemaValidate(ctx, req.Config.Schema, validateSchemaReq, &validateSchemaResp)

	resp.Diagnostics.Append(validateSchemaResp.Diagnostics...)
}

diff -ruN -x .git -x docs -x '*.orig' -x '*.out' -x '*.test' a/internal/fwserver/registry.go b/internal/fwserver/registry.go
--- a/internal/fwserver/registry.go	1970-01-01 00:00:00.000000000 +0000
+++ b/internal/fwserver/registry.go	2026-11-10 21:33:46.862668235 +0000
@@ -0,0 +1,91 @@
+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package fwserver
+
+import (
+	"context"
+	"fmt"
+	"sync"
+
+	"github.com/hashicorp/terraform-plugin-framework/diag"
+	"github.com/hashicorp/terraform-plugin-framework/internal/logging"
+)
+
+// factoryRegistry is the cached map of the provider-defined factory functions
+// of one concept (resources, data sources, ...) by type name, along with the
+// diagnostics raised while building it on first use.
+type factoryRegistry[T any] struct {
+	mu    sync.Mutex
+	funcs map[string]func() T
+	diags diag.Diagnostics
+}
+
+// factoryRegistryText is the concept-specific log and diagnostic text of a
+// factoryRegistry. The text is observable behavior, so it is kept per concept.
+type factoryRegistryText struct {
+	lockLog, callingLog, calledLog string
+	foundLog, logKey               string
+	// missingDetail is a format with a single %T verb for the instance and
+	// duplicateDetail a format with a single %s verb for the type name.
+	missingSummary, missingDetail     string
+	duplicateSummary, duplicateDetail string
+}
+
+const reportToProviderDevelopers = "This is always an issue with the provider and should be reported to the provider developers."
+
+// load returns the cached factory functions, building them on first use.
+// prepare is called once, under the lock, and returns the provider-defined
+// factories method, or nil if the provider does not implement the concept,
+// along with a function returning the type name of an instance. accept, if
+// non-nil, performs any additional validation of a uniquely named instance.
+func (r *factoryRegistry[T]) load(
+	ctx context.Context,
+	text *factoryRegistryText,
+	prepare func() (factories func(context.Context) []func() T, typeName func(T) string),
+	accept func(instance T, typeName string, diags *diag.Diagnostics) bool,
+) (map[string]func() T, diag.Diagnostics) {
+	logging.FrameworkTrace(ctx, text.lockLog)
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	if r.funcs != nil {
+		return r.funcs, r.diags
+	}
+
+	factories, typeNameOf := prepare()
+	r.funcs = make(map[string]func() T)
+
+	if factories == nil {
+		return r.funcs, r.diags
+	}
+
+	logging.FrameworkTrace(ctx, text.callingLog)
+	factoryFuncs := factories(ctx)
+	logging.FrameworkTrace(ctx, text.calledLog)
+
+	for _, factory := range factoryFuncs {
+		instance := factory()
+		typeName := typeNameOf(instance)
+
+		if typeName == "" {
+			r.diags.AddError(text.missingSummary, fmt.Sprintf(text.missingDetail, instance)+reportToProviderDevelopers)
+			continue
+		}
+
+		logging.FrameworkTrace(ctx, text.foundLog, map[string]interface{}{text.logKey: typeName})
+
+		if _, ok := r.funcs[typeName]; ok {
+			r.diags.AddError(text.duplicateSummary, fmt.Sprintf(text.duplicateDetail, typeName)+reportToProviderDevelopers)
+			continue
+		}
+
+		if accept != nil && !accept(instance, typeName, &r.diags) {
+			continue
+		}
+
+		r.funcs[typeName] = factory
+	}
+
+	return r.funcs, r.diags
+}

+	s := &Server{FrameworkServer: fwserver.Server{Provider: vbCapProvider{&seen}}}
+	typ := tftypes.Object{AttributeTypes: map[string]tftypes.Type{"plain": tftypes.String}}
+	dv, _ := tfprotov6.NewDynamicValue(typ, tftypes.NewValue(typ, map[string]tftypes.Value{"plain": tftypes.NewValue(tftypes.String, "p")}))
+	resp, _ := s.ValidateActionConfig(context.Background(), &tfprotov6.ValidateActionConfigRequest{ActionType: "vb_act", Config: &dv})

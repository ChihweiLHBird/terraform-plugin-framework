+		for _, d := range resp.Diagnostics {
+			t.Logf("DN1 ValidateActionConfig %s: %v %q %q", name, d.Severity, d.Summary, d.Detail)
+		}
+		if len(resp.Diagnostics) == 0 {
+			t.Logf("DN1 ValidateActionConfig %s: 0 diags", name)
+		}
+	}
+}

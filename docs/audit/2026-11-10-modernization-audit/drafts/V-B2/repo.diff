+func TestVB2_DN1(t *testing.T) {
+	t.Parallel()
+	s := &Server{FrameworkServer: fwserver.Server{Provider: vbActProvider{}}}
+	gps, _ := s.GetProviderSchema(context.Background(), &tfprotov6.GetProviderSchemaRequest{})
+	for _, a := range gps.ActionSchemas["vb_act"].Schema.Block.Attributes {
+		t.Logf("DN1 GetProviderSchema action attr %s write_only=%v", a.Name, a.WriteOnly)
+	}
+	t.Logf("DN1 GetProviderSchema diags=%s", vbDiags(gps.Diagnostics))
+	typ := tftypes.Object{AttributeTypes: map[string]tftypes.Type{"wo": tftypes.String, "plain": tftypes.String}}
+	for name, wo := range map[string]tftypes.Value{
+		"wo=\"secret\"": tftypes.NewValue(tftypes.String, "secret"),
+		"wo=<unknown>":  tftypes.NewValue(tftypes.String, tftypes.UnknownValue),
+		"wo=<null>":     tftypes.NewValue(tftypes.String, nil),
+	} {
+		cfg := tftypes.NewValue(typ, map[string]tftypes.Value{"wo": wo, "plain": tftypes.NewValue(tftypes.String, "p")})
+		resp, err := s.ValidateActionConfig(context.Background(), &tfprotov6.ValidateActionConfigRequest{ActionType: "vb_act", Config: vbDV(t, typ, cfg)})
+		if err != nil {
+			t.Fatal(err)

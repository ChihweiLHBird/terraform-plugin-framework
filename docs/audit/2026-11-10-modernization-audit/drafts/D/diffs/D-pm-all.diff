+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+// Package fwplanmodifier contains logic shared by the typed
+// resource/schema/<type>planmodifier packages.
+package fwplanmodifier
+
+import (
+	"github.com/hashicorp/terraform-plugin-go/tftypes"
+
+	"github.com/hashicorp/terraform-plugin-framework/attr"
+)
+
+// RequiresReplaceIfApplies reports whether a RequiresReplaceIf function
+// should be called: the resource is planned for update and the plan and
+// state values differ.
+func RequiresReplaceIfApplies(stateRaw, planRaw tftypes.Value, planValue, stateValue attr.Value) bool {
+	// Do not replace on resource creation.
+	if stateRaw.IsNull() {
+		return false
+	}
+
+	// Do not replace on resource destroy.
+	if planRaw.IsNull() {
+		return false
+	}
+
+	// Do not replace if the plan and state values are equal.
+	return !planValue.Equal(stateValue)
+}
+
+// UseStateForUnknownApplies reports whether the prior state value should be
+// copied into an unknown planned value.
+func UseStateForUnknownApplies(stateRaw tftypes.Value, planValue, configValue attr.Value) bool {
+	// Do nothing if there is no state (resource is being created).
+	if stateRaw.IsNull() {
+		return false
+	}
+
+	// Do nothing if there is a known planned value.
+	if !planValue.IsUnknown() {
+		return false
+	}
+
+	// Do nothing if there is an unknown configuration value, otherwise interpolation gets messed up.
+	return !configValue.IsUnknown()
+}
+
+// UseNonNullStateForUnknownApplies reports whether a non-null prior state
+// value should be copied into an unknown planned value.
+func UseNonNullStateForUnknownApplies(stateValue, planValue, configValue attr.Value) bool {
+	// Do nothing if the state value is null.
+	if stateValue.IsNull() {
+		return false
+	}
+
+	// Do nothing if there is a known planned value.
+	if !planValue.IsUnknown() {
+		return false
+	}
+
+	// Do nothing if there is an unknown configuration value, otherwise interpolation gets messed up.
+	return !configValue.IsUnknown()
+}

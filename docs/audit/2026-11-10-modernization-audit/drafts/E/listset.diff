diff -ruN repo/types/basetypes/collection_value.go draft4/types/basetypes/collection_value.go
--- repo/types/basetypes/collection_value.go	1970-01-01 00:00:00.000000000 +0000
+++ draft4/types/basetypes/collection_value.go	2026-10-24 23:07:42.046680069 +0000
@@ -0,0 +1,57 @@
+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package basetypes
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/hashicorp/terraform-plugin-go/tftypes"
+
+	"github.com/hashicorp/terraform-plugin-framework/attr"
+)
+
+// collectionToTerraformValue implements ToTerraformValue for ListValue and
+// SetValue. The name is used in the panic message for an unhandled state.
+func collectionToTerraformValue(ctx context.Context, collectionType tftypes.Type, name string, state attr.ValueState, elements []attr.Value) (tftypes.Value, error) {
+	switch state {
+	case attr.ValueStateKnown:
+		// MAINTAINER NOTE:
+		// ListValue and SetValue do not support DynamicType as an element type. It is not explicitly prevented from being created with the
+		// Framework type system, but the Framework-supported List and Set attributes and blocks all prevent DynamicType
+		// from being used as an element type.
+		//
+		// In the future, if we ever need to support a list or set of dynamic element types, this creation logic will need to be modified to ensure
+		// that known values contain the exact same concrete element type, specifically with unknown and null values. Dynamic values will return the correct concrete
+		// element type for known values from `elem.ToTerraformValue`, but unknown and null values will be tftypes.DynamicPseudoType, causing an error due to multiple element
+		// types in a tftypes.List or tftypes.Set.
+		//
+		// Unknown and null element types of tftypes.DynamicPseudoType must be recreated as the concrete element type unknown/null value. This can be done by checking `elements`
+		// for a single concrete type (i.e. not tftypes.DynamicPseudoType), and using that concrete type to create unknown and null dynamic values later.
+		//
+		vals := make([]tftypes.Value, 0, len(elements))
+
+		for _, elem := range elements {
+			val, err := elem.ToTerraformValue(ctx)
+
+			if err != nil {
+				return tftypes.NewValue(collectionType, tftypes.UnknownValue), err
+			}
+
+			vals = append(vals, val)
+		}
+
+		if err := tftypes.ValidateValue(collectionType, vals); err != nil {
+			return tftypes.NewValue(collectionType, tftypes.UnknownValue), err
+		}
+
+		return tftypes.NewValue(collectionType, vals), nil
+	case attr.ValueStateNull:
+		return tftypes.NewValue(collectionType, nil), nil
+	case attr.ValueStateUnknown:
+		return tftypes.NewValue(collectionType, tftypes.UnknownValue), nil
+	default:
+		panic(fmt.Sprintf("unhandled %s state in ToTerraformValue: %s", name, state))
+	}
+}

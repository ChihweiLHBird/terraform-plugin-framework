diff -ruN repo/types/basetypes/primitive_value.go draft/types/basetypes/primitive_value.go
--- repo/types/basetypes/primitive_value.go	1970-01-01 00:00:00.000000000 +0000
+++ draft/types/basetypes/primitive_value.go	2026-10-24 23:01:44.887227784 +0000
@@ -0,0 +1,70 @@
+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package basetypes
+
+import (
+	"fmt"
+
+	"github.com/hashicorp/terraform-plugin-go/tftypes"
+
+	"github.com/hashicorp/terraform-plugin-framework/attr"
+)
+
+// primitiveToTerraformValue implements ToTerraformValue for the primitive
+// value types. The name is used in the panic message for an unhandled state.
+func primitiveToTerraformValue(typ tftypes.Type, name string, state attr.ValueState, value any) (tftypes.Value, error) {
+	switch state {
+	case attr.ValueStateKnown:
+		if err := tftypes.ValidateValue(typ, value); err != nil {
+			return tftypes.NewValue(typ, tftypes.UnknownValue), err
+		}
+
+		return tftypes.NewValue(typ, value), nil
+	case attr.ValueStateNull:
+		return tftypes.NewValue(typ, nil), nil
+	case attr.ValueStateUnknown:
+		return tftypes.NewValue(typ, tftypes.UnknownValue), nil
+	default:
+		panic(fmt.Sprintf("unhandled %s state in ToTerraformValue: %s", name, state))
+	}
+}
+
+// primitiveEqual implements the state and value comparison of Equal for the
+// primitive value types whose Go value is comparable.
+func primitiveEqual[T comparable](state attr.ValueState, value T, otherState attr.ValueState, otherValue T) bool {
+	if state != otherState {
+		return false
+	}
+
+	if state != attr.ValueStateKnown {
+		return true
+	}
+
+	return value == otherValue
+}
+
+// primitiveString implements String for the primitive value types. The known
+// function is only called for a known value.
+func primitiveString(state attr.ValueState, known func() string) string {
+	if state == attr.ValueStateUnknown {
+		return attr.UnknownValueString
+	}
+
+	if state == attr.ValueStateNull {
+		return attr.NullValueString
+	}
+
+	return known()
+}
+
+// primitiveValuePointer implements Value<T>Pointer for the primitive value
+// types whose Go value is held directly: nil for a null value, otherwise a
+// pointer to a copy of the value (the zero value when unknown).
+func primitiveValuePointer[T any](state attr.ValueState, value T) *T {
+	if state == attr.ValueStateNull {
+		return nil
+	}
+
+	return &value
+}

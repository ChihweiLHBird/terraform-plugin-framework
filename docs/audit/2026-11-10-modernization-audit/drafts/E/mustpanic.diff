diff -ruN repo/types/basetypes/diagnostics_panic.go draft6/types/basetypes/diagnostics_panic.go
--- repo/types/basetypes/diagnostics_panic.go	1970-01-01 00:00:00.000000000 +0000
+++ draft6/types/basetypes/diagnostics_panic.go	2026-10-24 23:13:39.669868833 +0000
@@ -0,0 +1,28 @@
+// Copyright IBM Corp. 2021, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package basetypes
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/hashicorp/terraform-plugin-framework/diag"
+)
+
+// diagnosticsPanicString formats diagnostics for the panic message of the
+// New*ValueMust functions, one "severity | summary | detail" line per
+// diagnostic.
+func diagnosticsPanicString(diags diag.Diagnostics) string {
+	diagsStrings := make([]string, 0, len(diags))
+
+	for _, diagnostic := range diags {
+		diagsStrings = append(diagsStrings, fmt.Sprintf(
+			"%s | %s | %s",
+			diagnostic.Severity(),
+			diagnostic.Summary(),
+			diagnostic.Detail()))
+	}
+
+	return strings.Join(diagsStrings, "\n")
+}

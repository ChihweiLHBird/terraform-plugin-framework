 func FromValue(ctx context.Context, typ attr.Type, val interface{}, path path.Path) (attr.Value, diag.Diagnostics) {
 	var diags diag.Diagnostics
 
+	// A nil pointer whose element type implements one of the interfaces below
+	// by value receivers would panic when its methods are called: treat it as
+	// a null value, like any other nil pointer.
+	if rv := reflect.ValueOf(val); rv.Kind() == reflect.Pointer && rv.IsNil() && implementsValueInterface(rv.Type().Elem()) {
+		return FromPointer(ctx, typ, rv, path)
+	}
+
